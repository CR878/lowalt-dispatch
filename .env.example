# 本地开发环境变量样例。
# 复制成 .env 再填真实值。.env 已被 .gitignore 排除，**永远不会进仓库**。
# 提交前请再确认一次：git status 里不应该出现 .env。

APP_ENV=dev

# ---- 华为云（11/09 预检后再填，先别急着开通付费资源）----
HUAWEI_CLOUD_REGION=
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
RDS_DSN=
DCS_HOST=
DCS_PORT=6379
OBS_BUCKET=

# ---- 模型服务（MaaS）----
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=
# 完整chat/completions接口地址优先；不填时使用MAAS_BASE_URL/chat/completions。
MAAS_CHAT_ENDPOINT=

# ---- M3：默认全部在本地；配置云资源后显式切换，不会自动降级冒充成功 ----
M3_RUN_MODE=mock
M3_LEDGER_BACKEND=sqlite
M3_SQLITE_PATH=logs/agent/m3-ledger.sqlite3
M3_AUDIT_DIR=logs/agent/runs
M3_CACHE_BACKEND=none
DCS_PASSWORD=
DCS_TLS=true
M3_ARCHIVE_BACKEND=local
M3_ARCHIVE_DIR=logs/agent/archive
OBS_ENDPOINT=
HUAWEI_CLOUD_SECURITY_TOKEN=

# ---- 云边消息 ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID_CLOUD=cloud-api
MQTT_CLIENT_ID_EDGE=edge-agent
MQTT_USERNAME=
MQTT_PASSWORD=
# false只适用于本机开发；远程MQTT要求TLS和认证。
MQTT_TLS=false
MQTT_CA_FILE=
M3_VEHICLE_ID=px4-sitl-1
M3_ACK_TIMEOUT_S=3

# ---- 飞控接口（A 填）----
FC_TYPE=            # px4 | ardupilot
MAVSDK_ADDRESS=udpin://0.0.0.0:14540
