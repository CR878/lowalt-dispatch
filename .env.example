# 本地开发环境变量样例。
# 复制成 .env 再填真实值。.env 已被 .gitignore 排除，**永远不会进仓库**。
# 提交前请再确认一次：git status 里不应该出现 .env。

APP_ENV=dev

# ---- M5 API（当前进程就能用，不需要云资源）----
# memory：进程内 SQLite，退出即失。sqlite：本地文件，默认 data/api.sqlite，已在 .gitignore。
# 这两种都还不是 PostgreSQL / Redis。
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/api.sqlite
API_HOST=127.0.0.1
API_PORT=8000

# 规划器入口，写成 模块:函数。留空则调用已入库的几何基线 planner.astar:plan_scenario。
# M2 的备降可达性规划器合入后，只改这一行，不用改路由。
PLANNER_ENTRY=

# M3 任务 Agent 入口，写成 模块:函数。留空表示未接入。
# 规划完成后会把 task_id / snapshot_id / route_id 传进去，但本服务不会按返回值改路线。
# 不要把密钥写在这里。
AGENT_ENTRY=

# PostgreSQL / Redis 的通用别名。和下面的 RDS_DSN、DCS_HOST 一样，只是配置位：
# 填了以后 /health 会显示 configured=true、connected=false，本版本不会去连接。
DATABASE_URL=
REDIS_URL=

# ---- 华为云（11/09 预检后再填，先别急着开通付费资源）----
HUAWEI_CLOUD_REGION=
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
RDS_DSN=
DCS_HOST=
DCS_PORT=6379
OBS_BUCKET=

# ---- 模型服务（MaaS）----
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=

# ---- 云边消息 ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID_CLOUD=cloud-api
MQTT_CLIENT_ID_EDGE=edge-agent

# ---- 飞控接口（A 填）----
FC_TYPE=            # px4 | ardupilot
MAVSDK_ADDRESS=udpin://0.0.0.0:14540
