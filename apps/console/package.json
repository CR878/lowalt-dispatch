{
  "name": "lowalt-flight-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assistant": "node scripts/run-assistant.mjs",
    "dev:all": "node scripts/run-local.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json index.html README.md",
    "format:check": "prettier --check src tests scripts/*.mjs *.ts *.json index.html README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
