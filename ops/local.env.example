# 本地 Docker 模式：不买、不开通任何华为云资源
#
# 用法：
#   cp ops/local.env.example .env
#   docker compose -f ops/docker-compose.yml up -d
#
# 然后把 .env 喂给 CLI（只有显式 --env-file 才会读文件）：
#   .venv/Scripts/python.exe -m agent.integration --env-file .env check
#
# 注意几件事：
#   * M3_LEDGER_BACKEND=rds 里的 "rds" 只是**后端类型名**（PostgreSQL），
#     这里指向本机容器，不代表买了云数据库。settings.py 只有 sqlite / rds 两档。
#   * DCS_TLS 必须 false。settings.py 默认是 true（云上必须开 TLS），
#     本地容器没有证书，留着 true 会直接连不上。
#   * M3_RUN_MODE 和"用不用云"无关：它表示工具是 MOCK 还是非 MOCK。
#     本地连了 Postgres/Redis 也仍然是 mock。
#   * 下面的密码只用于本机开发，端口也只绑 127.0.0.1。不要复制到任何共享环境。

APP_ENV=dev

# ---- 任务台账：本机 PostgreSQL 容器 ----
M3_RUN_MODE=mock
M3_LEDGER_BACKEND=rds
RDS_DSN=postgresql+psycopg://lowalt:lowalt_dev_only@127.0.0.1:5432/lowalt
M3_SQLITE_PATH=logs/agent/m3-ledger.sqlite3
M3_AUDIT_DIR=logs/agent/runs

# ---- 状态投影：本机 Redis 容器（不持久化，重启即丢）----
M3_CACHE_BACKEND=redis
DCS_HOST=127.0.0.1
DCS_PORT=6379
DCS_PASSWORD=
DCS_TLS=false

# ---- 审计归档：本地目录（不用 OBS）----
M3_ARCHIVE_BACKEND=local
M3_ARCHIVE_DIR=logs/agent/archive

# ---- 消息：本机 Mosquitto ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID_CLOUD=cloud-api
MQTT_CLIENT_ID_EDGE=edge-agent
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_FILE=
M3_VEHICLE_ID=px4-sitl-1
M3_ACK_TIMEOUT_S=3

# ---- 仅供 tests/test_m3_external.py：设了就真跑，不设就 skip ----
M3_TEST_POSTGRES_DSN=postgresql+psycopg://lowalt:lowalt_dev_only@127.0.0.1:5432/lowalt
M3_TEST_REDIS_URL=redis://127.0.0.1:6379/0
M3_TEST_MQTT_HOST=127.0.0.1
M3_TEST_MQTT_PORT=1883

# ---- 以下留空：本地模式不接模型、不接 OBS、不碰 AK/SK ----
MAAS_CHAT_ENDPOINT=
MAAS_MODEL=
MAAS_API_KEY=
OBS_ENDPOINT=
OBS_BUCKET=
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
HUAWEI_CLOUD_SECURITY_TOKEN=

# ---- 飞控接口（A 填）----
FC_TYPE=            # px4 | ardupilot
MAVSDK_ADDRESS=udpin://0.0.0.0:14540
