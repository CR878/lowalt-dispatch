# Default local mode needs no cloud credentials and makes no external model calls.
ASSISTANT_PROVIDER=local

# Configure a full chat-completions endpoint and a model supporting tool calls.
# Change provider to maas only after setting your own account credentials.
# Never prefix any of these with VITE_.
ASSISTANT_MAAS_ENDPOINT=
ASSISTANT_MAAS_MODEL=
ASSISTANT_MAAS_API_KEY=
